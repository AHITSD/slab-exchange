# Port the app listens on (most hosts set this for you)
PORT=3000
# Folder where prices and price history are saved. Point it at a persistent disk in production.
DATA_DIR=./data
# How often the server checks whether any source is due, in seconds (each source has its own schedule)
CHECK_EVERY_SECONDS=60
# Secret for POST /api/collect, which runs every source straight away. Leave empty to switch it off.
ADMIN_TOKEN=
# Paid PriceCharting / SportsCardsPro API token. Without it, graded and sports prices stay at the 10 Oct 2026 snapshot.
PRICECHARTING_TOKEN=
# Optional Pokémon TCG API key for higher request limits
POKEMONTCG_API_KEY=
# Sent with every request to the price sources. Scryfall asks for a name and contact.
USER_AGENT=SlabExchange/1.0 (you@example.com)
